{
  "name": "@penclipai/ui",
  "version": "0.3.1",
  "description": "Prebuilt Paperclip board UI assets.",
  "license": "MIT",
  "homepage": "https://github.com/penclipai/paperclip-cn",
  "bugs": {
    "url": "https://github.com/penclipai/paperclip-cn/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/penclipai/paperclip-cn",
    "directory": "ui"
  },
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/i18n-catalog.mjs check --root .. && vite",
    "build": "node ../scripts/i18n-catalog.mjs check --root .. && vite build",
    "build:preview": "node ../scripts/i18n-catalog.mjs check --root .. && vite build --config vite.preview.config.mjs",
    "storybook": "node ../scripts/i18n-catalog.mjs check --root .. && storybook dev -p 6006 -c storybook/.storybook",
    "build-storybook": "node ../scripts/i18n-catalog.mjs check --root .. && storybook build -c storybook/.storybook -o storybook-static",
    "preview": "node ../scripts/i18n-catalog.mjs check --root .. --artifact-root ui/dist/locales && vite preview",
    "typecheck": "tsc -b",
    "clean": "node ../scripts/fs-ops.mjs rm dist dist-preview storybook-static tsconfig.tsbuildinfo",
    "prepack": "node ../scripts/fs-ops.mjs rm package.dev.json && node ../scripts/fs-ops.mjs cp package.json package.dev.json && node ../scripts/generate-ui-package-json.mjs",
    "postpack": "node ../scripts/fs-ops.mjs mv package.dev.json package.json --if-exists"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/link": "0.48.0",
    "@mdxeditor/editor": "^4.2.3",
    "@penclipai/adapter-claude-local": "workspace:*",
    "@penclipai/adapter-codex-local": "workspace:*",
    "@penclipai/adapter-cursor-cloud": "workspace:*",
    "@penclipai/adapter-cursor-local": "workspace:*",
    "@penclipai/adapter-gemini-local": "workspace:*",
    "@penclipai/adapter-grok-local": "workspace:*",
    "@penclipai/adapter-kimi-local": "workspace:*",
    "@penclipai/adapter-openclaw-gateway": "workspace:*",
    "@penclipai/adapter-opencode-local": "workspace:*",
    "@penclipai/adapter-pi-local": "workspace:*",
    "@penclipai/adapter-utils": "workspace:*",
    "@penclipai/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.102.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "lexical": "0.48.0",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.17.2",
    "motion": "^13.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "yjs": "13.6.32",
    "@penclipai/adapter-codebuddy-local": "workspace:*",
    "@penclipai/adapter-qwen-local": "workspace:*",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2"
  },
  "devDependencies": {
    "@penclipai/plugin-sdk": "workspace:*",
    "@sentry/browser": "10.71.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
